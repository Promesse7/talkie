# Firebase web app config. These values are public to the browser, but you should
# restrict the API key to your domains in Google Cloud console > Credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Translation backend. Server-side only: never prefix these with VITE_.
# /api/translate only serves signed-in users; it verifies their Firebase ID token with this
# key. Optional: falls back to VITE_FIREBASE_API_KEY (same public web key).
FIREBASE_WEB_API_KEY=
# TRANSLATE_PROVIDER is one of: nllb | google | libretranslate | huggingface | none
TRANSLATE_PROVIDER=nllb
# nllb: real NLLB-200 served by the open-source nllb-api. No key, no card. Leave NLLB_API_URL
# empty to use the project author's public Space (fine for a pilot), or duplicate that Space
# into your own Hugging Face account (free) and put its URL here, e.g. https://you-nllb-api.hf.space
NLLB_API_URL=
# Google Cloud Translation (basic/v2) API key. First 500k characters/month are free and all
# nine Talkie languages (incl. Kinyarwanda, Swahili) are supported. See README > Translation.
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com
# libretranslate.com requires a key (get one at https://portal.libretranslate.com); a self-hosted instance usually does not.
LIBRETRANSLATE_API_KEY=
HF_API_TOKEN=
HF_MODEL=facebook/nllb-200-distilled-600M
